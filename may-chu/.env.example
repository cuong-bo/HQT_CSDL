# Copy to may-chu/.env (cp .env.example .env) and fill in. The real .env is never committed.
#   openssl rand -base64 32     (use a different value for each line)

POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
JWT_KEY=change-me-at-least-32-characters-long-random

# Private key that signs every API reply (see scripts/gen-signing-key.sh); the app checks it with the public key.
# Leave empty to switch signing off.
SIGNING_KEY=

# Clients older than this are told to update (GET /v1/config).
MIN_CLIENT_VERSION=1.0.0

# Base map tiles announced to every app (GET /v1/config). Leave empty to keep the app's built-in addresses (Google, development only).
# Each address must be http(s) and contain {x}, {y} and {zoom}, e.g. https://tiles.example/{zoom}/{x}/{y}.png
TILE_ATTRIBUTION=
TILE_URL_ROADMAP=
TILE_URL_SATELLITE=
TILE_URL_HYBRID=
TILE_URL_TERRAIN=
