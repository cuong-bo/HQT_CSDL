# Copy to may-chu/.env (cp .env.example .env) and fill in. The real .env is never committed.
#   openssl rand -base64 32     (use a different value for each line)

POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
JWT_KEY=change-me-at-least-32-characters-long-random

# Private key that signs every API reply (see scripts/gen-signing-key.sh); the app checks it with the public key.
# Leave empty to switch signing off.
SIGNING_KEY=

# The assistant: DeepSeek V4.1 Flash through the OpenCode API (opencode.ai). Create a key in the OpenCode console and SET A LOW SPENDING LIMIT there.
# Never commit the real key. Empty = the assistant is switched off. Model ids: GET https://opencode.ai/inference/v1/models
# ("deepseek-v4.1-flash-free" is the free tier if your account has it).
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# Endpoint. Default (leave empty) = pay-as-you-go OpenCode Models credits. With an OpenCode Go subscription use the Go endpoint instead,
# otherwise requests are billed to credits and fail with 402 "Insufficient balance":
#OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# The community feed "Khoảnh khắc": false until HTTPS is on and someone handles the approval queue and the reports.
FEED_ENABLED=false

# Clients older than this are told to update (GET /v1/config).
MIN_CLIENT_VERSION=1.0.0

# Base map tiles announced to every app (GET /v1/config). Leave empty to keep the app's built-in addresses (Google, development only).
# Each address must be http(s) and contain {x}, {y} and {zoom}, e.g. https://tiles.example/{zoom}/{x}/{y}.png
TILE_ATTRIBUTION=
TILE_URL_ROADMAP=
TILE_URL_SATELLITE=
TILE_URL_HYBRID=
TILE_URL_TERRAIN=
