{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "hue-travel",
    "Audience": "hue-travel-app",
    "AccessMinutes": 15,
    "RefreshDays": 30
  },
  "RateLimit": {
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "HeavyPerMinute": 30
  },
  "Client": {
    "MinimumVersion": "1.0.0",
    "TileUrl": "http://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={zoom}",
    "TileAttribution": "Bản đồ © Google"
  }
}
