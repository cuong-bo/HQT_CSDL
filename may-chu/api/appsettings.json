{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "hue-travel",
    "Audience": "hue-travel-app",
    "AccessMinutes": 15,
    "RefreshDays": 30
  },
  "RateLimit": {
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "HeavyPerMinute": 30,
    "ChatPerMinute": 6,
    "FeedPerMinute": 40
  },
  "Feed": {
    "Enabled": false
  },
  "Chat": {
    "BaseUrl": "https://opencode.ai/inference/openai/v1",
    "Model": "deepseek-v4.1-flash",
    "GuestPerDay": 20,
    "UserPerDay": 100
  },
  "Client": {
    "MinimumVersion": "1.0.0",
    "TileUrl": "http://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={zoom}",
    "TileAttribution": "Bản đồ © Google"
  }
}
