<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Address of the Hue Travel server, e.g. http://203.0.113.10 . Empty = offline. Overridden by the HUE_API_URL environment variable and by %ProgramData%\HueTravel\server.txt. -->
        <add key="ApiBaseUrl" value="" />
        <!-- The server's public signing key (base64, from may-chu/scripts/gen-signing-key.sh). When set, replies without a valid signature are refused. -->
        <add key="ApiPublicKey" value="" />
    </appSettings>
</configuration>