# Copy to deploy/.env and fill in. The real .env is never committed.
#   openssl rand -base64 32     (use a different value for each line)

POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
JWT_KEY=change-me-at-least-32-characters-long-random

# Clients older than this are told to update (GET /v1/config).
MIN_CLIENT_VERSION=1.0.0
